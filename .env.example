# Proveedor del modelo de lenguaje: anthropic | gemini | mock (mock = agente simulado sin clave, para pruebas)
LLM_PROVIDER=gemini
# Clave de Google AI Studio. Solo en el backend; nunca en el repositorio ni en el front.
GEMINI_API_KEY=
# Clave de la API de Anthropic (si LLM_PROVIDER=anthropic). Solo en el backend.
ANTHROPIC_API_KEY=
# Modelo a usar (obligatorio, sin valor por defecto en el código)
LLM_MODEL=
# Tope de iteraciones herramienta → modelo por turno (default 25)
MAX_ITER=
# Tope de tokens por sesión (default 200000)
MAX_TOKENS_SESION=
# Puerto HTTP (default 3000)
PORT=
